---
import Section from "./Section.astro";
import type { EducationProps } from "@types";

interface Props {
  education: EducationProps[];
}

const { education } = Astro.props;
---

<Section text="Education" href="education">
  {
    education.map(({ degree, institution, location, period, grade }) => (
      <div class="mb-10">
        <h3 class="mb-2 font-serif text-2xl font-semibold text-white">
          {degree}
        </h3>

        <h4 class="mb-1 font-serif text-xl font-medium text-primary">
          {institution}
        </h4>

        <p class="mb-2 text-sm text-white/70">
          {location} · {period}
        </p>

        <p class="text-base text-neutral">
          {grade}
        </p>
      </div>
    ))
  }
</Section>
