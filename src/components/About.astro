---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "@types";

type Props = Pick<AboutProps, "description"> & Pick<HeroProps, "name">;

const { description } = Astro.props;
---

<Section text="About Me" href="about">
  <p class="text-base text-neutral md:text-lg whitespace-pre-line">
    {description}
  </p>
</Section>
