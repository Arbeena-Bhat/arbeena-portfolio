---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="grid gap-8 md:grid-cols-2">
    {
      projects.map(({ name, summary, image, linkSource, linkPreview }) => (
        <article class="overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85">
          <div class="h-56 overflow-hidden">
            <Image
              class="h-full w-full object-cover"
              src={image}
              alt={name}
              width="736"
              height="483"
            />
          </div>

          <div class="p-6">
            <h3 class="mb-3 font-serif text-2xl font-medium text-primary">
              {name}
            </h3>

            <p class="text-base text-neutral">
              {summary}
            </p>

            <div class="flex gap-5 pt-6 text-white">
              {
                linkSource && (
                  <a
                    href={linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary hover:underline"
                  >
                    GitHub →
                  </a>
                )
              }

              {
                linkPreview && linkPreview !== "/" && (
                  <a
                    href={linkPreview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary hover:underline"
                  >
                    Preview →
                  </a>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
